{
  "manifest_version": 2,
  "name": "ARGOS Media Bridge",
  "version": "0.1.4",
  "description": "ARGOS: reproducir YouTube en tu Firefox, con tus cuentas y bloqueador, y comprobar reproducción.",
  "browser_specific_settings": {
    "gecko": {
      "id": "firefox@argos.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity",
          "websiteContent",
          "websiteActivity"
        ]
      }
    }
  },
  "permissions": [
    "nativeMessaging",
    "https://www.youtube.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  }
}
